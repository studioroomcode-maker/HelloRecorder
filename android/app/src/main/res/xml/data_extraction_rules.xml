<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+(API 31+) 백업/기기간 전송 규칙.
   녹음 앱이므로 어떤 사용자 데이터도 기기 밖으로 나가지 않게 모든 도메인을 제외한다.
   (allowBackup="false" 가 클라우드 백업을 막지만, 12+ 의 기기간 전송(device-transfer)은
    별도라 여기서 함께 차단한다.)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
